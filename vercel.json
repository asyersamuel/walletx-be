{
  "version": 2,
  "builds": [
    {
      "src": "api/index.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.go"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/keep-alive",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/cron/imap",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/v1/cron/recurring",
      "schedule": "0 18 * * *"
    }
  ]
}
