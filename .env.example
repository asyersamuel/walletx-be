# Local runtime. Supabase CLI owns the local Postgres container.
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Application security
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRATION=720
GIN_MODE=debug
DEV_MODE=true
APP_URL=http://localhost:8080

# Redis is used by Telegram state and JWT blacklist.
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Telegram and email integrations
TELEGRAM_BOT_TOKEN=
IMAP_EMAIL=
IMAP_PASSWORD=
IMAP_SERVER=imap.gmail.com:993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional parser integration
GEMINI_API_KEY=

# Cron authentication
CRON_SECRET=replace-with-a-long-random-value

# Local static media
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MEDIA_BASE_URL=/uploads
