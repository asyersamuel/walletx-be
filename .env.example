# Local runtime. Supabase CLI owns the local Postgres container.
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

# Supabase settings: URL and service-role key are required for receipt provider supabase.
# Use the project origin (https://<project-ref>.supabase.co); keep the key server-side.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application settings
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRATION=720
GIN_MODE=debug
DEV_MODE=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Gemini AI 
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash

# Receipt storage: local (default) or supabase. Supabase uploads use the receipts bucket.
# For local storage, the directory must survive process/container restarts.
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_STORAGE_DIR=.data/receipts
RECEIPT_STORAGE_TIMEOUT=30s
RECEIPT_AI_TIMEOUT=20s
